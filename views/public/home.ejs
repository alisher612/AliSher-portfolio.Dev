<!-- ============================================ -->
<!--        DELIVERED & LIVE PROJECTS SECTION     -->
<!-- ============================================ -->
<section class="delivered container" id="delivered">

  <div class="section-header">
    <span class="badge-pill-large">
      <span class="dot"></span>
      Client &amp; Live Work
    </span>

    <h2 class="section-title">
      Delivered &amp; <span class="hl">Live Projects</span>
    </h2>

    <p class="section-subtitle">
      Real-world projects delivered to a client and shared live with university students.
    </p>
  </div>

  <div class="live-grid">
    <% deliveredProjects.forEach(project => {
         const plain = (project.description || '').replace(/<[^>]*>/g, '');
         const short = plain.length > 150 ? plain.substring(0, 150) + '...' : plain;
    %>
      <article class="live-card">

        <div class="live-media">
          <img src="<%= project.image.url %>" alt="<%= project.title %>" loading="lazy">
          <span class="live-tag <%= project.clientName ? 'client' : '' %>">
            <%= project.clientName ? 'Client Delivered' : 'Live Project' %>
          </span>
        </div>

        <div class="live-body">
          <h3 class="live-title"><%= project.title %></h3>
          <p class="live-desc"><%= short %></p>

          <% if (project.clientName) { %>
            <p class="live-client">Client: <strong><%= project.clientName %></strong></p>
          <% } %>

          <% if (project.liveLink) { %>
            <a href="<%= project.liveLink %>" target="_blank" rel="noopener" class="btn btn-primary">
              View Live Project
            </a>
          <% } %>
        </div>

      </article>
    <% }) %>
  </div>

</section>

<!-- ============================================ -->
<!--              FEATURED PROJECTS               -->
<!-- ============================================ -->
<section class="projects container" id="projects">

  <div class="section-header">
    <h2 class="section-title">Featured <span class="hl">Projects</span></h2>
    <p class="section-subtitle">
      Product, web, AI and app builds designed for user engagement and business growth.
    </p>
  </div>

  <div class="projects-grid">
    <% projects.forEach(project => { %>

      <div class="project-card" onclick="goToProject('<%= project._id %>')">

        <div class="project-image">
          <img src="<%= project.image.url %>" alt="<%= project.title %>">
          <span class="project-badge">
            <%= project.category %>
          </span>

          <button class="project-overlay" onclick="event.stopPropagation(); goToProject('<%= project._id %>')">
            <i class="fas fa-arrow-right"></i>
          </button>
        </div>

        <div class="project-content" onclick="goToProject('<%= project._id %>')">
          <h3 class="project-title">
            <%= project.title %>
          </h3>

          <p class="project-desc">
            <% const plainText = project.description.replace(/<[^>]*>/g, ''); %>
            <%= plainText.length > 120 ? plainText.substring(0, 120) + "..." : plainText %>
          </p>

          <div class="project-tags">
            <% project.technologies.forEach(tag => { %>
              <span onclick="event.stopPropagation(); goToProject('<%= project._id %>')">
                #<%= tag %>
              </span>
            <% }) %>
          </div>
        </div>

      </div>

    <% }) %>
  </div>

  <!-- Toggle Button -->
  <div class="projects-btn">
    <button id="toggleBtn" class="btn btn-outline">
      <i class="fas fa-plus"></i> Show More
    </button>
  </div>

</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {

    const cards = document.querySelectorAll(".project-card");
    const btn = document.getElementById("toggleBtn");

    let expanded = false;

    function updateView() {
      cards.forEach((card, index) => {
        if (!expanded && index > 2) {
          card.style.display = "none";
        } else {
          card.style.display = "block";
        }
      });
    }

    updateView();

    btn.addEventListener("click", () => {
      expanded = !expanded;

      btn.innerHTML = expanded
        ? '<i class="fas fa-minus"></i> Show Less'
        : '<i class="fas fa-plus"></i> Show More';

      updateView();
    });

    // hide button if not needed
    if (cards.length <= 3) {
      btn.style.display = "none";
    }

  });
</script>

